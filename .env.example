# Copy this file to `.env` and fill in the real values.
# NEVER commit a real key. Real keys are pasted into `.env` by hand only.
#
# Environment variables here are SECRETS. Everything changeable about the
# pipeline (model ids, temps, token caps, timeouts, rate limits, concurrency,
# file limits, pricing) lives in `src/lib/config.ts`, not in `.env`.

# Gemini API key (Google AI Studio / Google Cloud).
# Required for the real AI provider path (the "analysis" and "summarisation" roles).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Only used if you explicitly choose the openai provider in the UI.
# OPENAI_API_KEY=

# SQLite database URL used by Prisma (relative to ./prisma).
DATABASE_URL="file:./dev.db"

# How many trusted reverse proxies sit in front of this process.
# 0 (default) = ignore X-Forwarded-For entirely, all requests share one bucket.
# 1 = single-proxy deploy (Render, Railway, Fly, Vercel, nginx).
# 2 = two-hop chain we control, e.g. CDN -> nginx -> app.
# Leave at 0 for local development and direct access.
# TRUSTED_PROXY_HOPS=0

# Optional. Defaults to development.
# NODE_ENV=development